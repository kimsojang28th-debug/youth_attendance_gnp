rules_version = '2';

// ============================================================
// 청소년부 재적관리 프로그램 - Firestore 보안 규칙
// ------------------------------------------------------------
// - 로그인한 사용자만 데이터를 읽고 쓸 수 있습니다.
// - classes / users 컬렉션은 관리자(부장)만 수정할 수 있습니다.
// - students / attendance 는 관리자이거나, 본인이 담당하는 반(classIds)에
//   한해서만 수정할 수 있습니다.
// - Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 붙여넣고
//   "게시(Publish)" 하세요. (README.md 4단계 참고)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function myClassIds() {
      return isSignedIn() ? myProfile().classIds : [];
    }

    // 사용자(교사/관리자) 계정 정보 - 본인 문서는 조회 가능, 수정은 관리자만
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 반 목록 - 전체 조회 가능, 수정은 관리자만
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 재적부(학생) - 관리자는 전체, 교사는 본인 반만 생성/수정 가능
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.classId in myClassIds());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.classId in myClassIds());
    }

    // 출석 기록 - 관리자는 전체, 교사는 본인 반만 기록 가능
    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.resource.data.classId in myClassIds());
      allow delete: if isAdmin();
    }

    // 주간보고서 메타 정보(설교/헌금/심방 등) - 로그인한 누구나 입력 가능
    match /weeklyMeta/{date} {
      allow read, write: if isSignedIn();
    }

    // 재적 변동 이력 - 로그인한 누구나 조회/기록/수정/삭제 가능
    // (학생 삭제 시 관련 이력도 함께 삭제되는데, 이 때 담당 교사도 삭제할 수 있어야 하므로 admin으로 제한하지 않음)
    match /rosterHistory/{historyId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // 연간계획(절기/교회행사/주일행사/청소년부행사/비고) - weeklyMeta와 동일하게 로그인한 누구나 등록/수정/삭제 가능
    match /yearlyPlan/{date} {
      allow read, write: if isSignedIn();
    }
  }
}
